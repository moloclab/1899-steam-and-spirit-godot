[gd_resource type="Resource" load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/actions/action_sequence.gd" id="sequence"]
[ext_resource type="Script" path="res://scripts/actions/action_step.gd" id="step"]

[sub_resource type="Resource" id="greeting"]
script = ExtResource("step")
text_key = "cabin.interphone.greeting"

[sub_resource type="Resource" id="summons"]
script = ExtResource("step")
text_key = "cabin.interphone.summons"
speaker = "Kelvin"

[sub_resource type="Resource" id="urgency"]
script = ExtResource("step")
text_key = "cabin.interphone.urgency"
speaker = "Kelvin"

[sub_resource type="Resource" id="reply"]
script = ExtResource("step")
text_key = "cabin.interphone.reply"
wait_for_completion = false

[resource]
script = ExtResource("sequence")
steps = Array[ExtResource("step")]([SubResource("greeting"), SubResource("summons"), SubResource("urgency"), SubResource("reply")])
