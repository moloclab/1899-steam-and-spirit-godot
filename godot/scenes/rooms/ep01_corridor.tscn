[gd_scene load_steps=29 format=3]

; Disposizione, grafica e risposte base della stanza; le azioni specifiche sono nel .gd omonimo.
; ExtResource richiama file esterni, SubResource definisce risorse incorporate in questa scena.
; Le coordinate di posizione e hit_size usano i pixel originali, prima della scala della stanza.

[ext_resource type="Script" path="res://scripts/data/item_definition.gd" id="inventory_definition"]
[ext_resource type="Script" path="res://scenes/rooms/ep01_corridor.gd" id="room_script"]
[ext_resource type="Texture2D" path="res://assets/graphics/ep01_corridor/corridor_background.png" id="background"]
[ext_resource type="Script" path="res://scripts/data/room_definition.gd" id="room_definition_definition"]
[ext_resource type="Script" path="res://scripts/hotspots/room_exit.gd" id="exit_script"]
[ext_resource type="Texture2D" path="res://assets/graphics/ep01_cabin/door_sub.png" id="door_cabina_door_cabina"]
[ext_resource type="Script" path="res://scripts/hotspot.gd" id="hotspot_script"]
[ext_resource type="Texture2D" path="res://assets/graphics/ep01_corridor/label.png" id="label_cabina_label_cabina"]
[ext_resource type="Texture2D" path="res://assets/graphics/ep01_corridor/ax_box.png" id="axBoxClose_axBoxClose"]
[ext_resource type="Texture2D" path="res://assets/graphics/ep01_corridor/smoker.png" id="smoker_sheet"]
[ext_resource type="Texture2D" path="res://assets/graphics/ep01_corridor/r2_wire_h.png" id="wireH_wireH"]
[ext_resource type="Texture2D" path="res://assets/graphics/ep01_corridor/wire_v.png" id="wireVNormal_wireVNormal"]
[ext_resource type="Texture2D" path="res://assets/graphics/ep01_corridor/lamp.png" id="lampBlink_sheet"]
[ext_resource type="Texture2D" path="res://assets/graphics/ep01_corridor/stair.png" id="stair_stair"]
[ext_resource type="Texture2D" path="res://assets/graphics/ep01_corridor/man_hole.png" id="manhole_manhole"]

; Metadati letti dal catalogo senza istanziare la stanza. Gli ingressi indicano la X di Churchill.
[sub_resource type="Resource" id="room_definition"]
script = ExtResource("room_definition_definition")
room_id = "ep01_corridor"
episode_id = "ep01"
scene_path = "res://scenes/rooms/ep01_corridor.tscn"
width = 892.0
entries = Dictionary[String, float]({"default": 94.0, "from_cabin": 94.0})

; Marinaio: sei ritagli da 40 x 108 pixel del foglio di animazione.
[sub_resource type="AtlasTexture" id="smoker_frame_0"]
atlas = ExtResource("smoker_sheet")
region = Rect2(0, 0, 40, 108)

[sub_resource type="AtlasTexture" id="smoker_frame_1"]
atlas = ExtResource("smoker_sheet")
region = Rect2(40, 0, 40, 108)

[sub_resource type="AtlasTexture" id="smoker_frame_2"]
atlas = ExtResource("smoker_sheet")
region = Rect2(80, 0, 40, 108)

[sub_resource type="AtlasTexture" id="smoker_frame_3"]
atlas = ExtResource("smoker_sheet")
region = Rect2(120, 0, 40, 108)

[sub_resource type="AtlasTexture" id="smoker_frame_4"]
atlas = ExtResource("smoker_sheet")
region = Rect2(160, 0, 40, 108)

[sub_resource type="AtlasTexture" id="smoker_frame_5"]
atlas = ExtResource("smoker_sheet")
region = Rect2(200, 0, 40, 108)

; Animazione ciclica: duration pesa ogni fotogramma, speed esprime i fotogrammi al secondo.
[sub_resource type="SpriteFrames" id="smoker_frames"]
animations = [{"frames": [{"duration": 1.0, "texture": SubResource("smoker_frame_0")}, {"duration": 1.0, "texture": SubResource("smoker_frame_1")}, {"duration": 1.0, "texture": SubResource("smoker_frame_2")}, {"duration": 1.0, "texture": SubResource("smoker_frame_3")}, {"duration": 1.0, "texture": SubResource("smoker_frame_4")}, {"duration": 1.0, "texture": SubResource("smoker_frame_5")}], "loop": true, "name": &"default", "speed": 3.3333333333333335}]

; Lampada: quattro ritagli da 52 x 64 pixel del foglio di animazione.
[sub_resource type="AtlasTexture" id="lampBlink_frame_0"]
atlas = ExtResource("lampBlink_sheet")
region = Rect2(0, 0, 52, 64)

[sub_resource type="AtlasTexture" id="lampBlink_frame_1"]
atlas = ExtResource("lampBlink_sheet")
region = Rect2(52, 0, 52, 64)

[sub_resource type="AtlasTexture" id="lampBlink_frame_2"]
atlas = ExtResource("lampBlink_sheet")
region = Rect2(104, 0, 52, 64)

[sub_resource type="AtlasTexture" id="lampBlink_frame_3"]
atlas = ExtResource("lampBlink_sheet")
region = Rect2(156, 0, 52, 64)

; Animazione ciclica: duration pesa ogni fotogramma, speed esprime i fotogrammi al secondo.
[sub_resource type="SpriteFrames" id="lampBlink_frames"]
animations = [{"frames": [{"duration": 1.0, "texture": SubResource("lampBlink_frame_0")}, {"duration": 1.0, "texture": SubResource("lampBlink_frame_1")}, {"duration": 1.0, "texture": SubResource("lampBlink_frame_2")}, {"duration": 1.0, "texture": SubResource("lampBlink_frame_3")}], "loop": true, "name": &"default", "speed": 0.1}]

; Radice del corridoio: usa lo script della stanza e dichiara esplicitamente gli elenchi vuoti.
[node name="CORRIDOR" type="Node2D"]
script = ExtResource("room_script")
definition = SubResource("room_definition")
; Definizioni della stanza di origine: disponibili nel catalogo anche quando è caricata un’altra stanza.
inventory_definitions = Array[ExtResource("inventory_definition")]([])

; Fondale largo: il gestore delle stanze applica lo scorrimento al seguito di Churchill.
[node name="Background" type="Sprite2D" parent="."]
texture = ExtResource("background")
centered = false

; Ritorno alla cabina: l’ingresso nominato risolve la posizione nella stanza di destinazione.
[node name="door_cabina" type="Node2D" parent="."]
script = ExtResource("exit_script")
hotspot_id = "return"
hit_size = Vector2(76, 116)
examine_response = "ep01.corridor.cabin_sign.examine"
interaction_response = "ep01.cabin.door.return"
destination_room = "ep01_cabin"
destination_entry = "from_corridor"
interaction_kind = "exit"
position = Vector2(56, 84)

; Figlio grafico: il genitore mantiene posizione, area cliccabile e comportamento.
[node name="Visual" type="Sprite2D" parent="door_cabina"]
centered = false
texture = ExtResource("door_cabina_door_cabina")
flip_h = true

; Targhetta della cabina: hotspot statico con la risposta predefinita del prototipo.
[node name="label_cabina" type="Node2D" parent="."]
script = ExtResource("hotspot_script")
hotspot_id = "label_cabina"
hit_size = Vector2(20, 12)
interaction_kind = "hand"
position = Vector2(84, 72)

; Figlio grafico: il genitore mantiene posizione, area cliccabile e comportamento.
[node name="Visual" type="Sprite2D" parent="label_cabina"]
centered = false
texture = ExtResource("label_cabina_label_cabina")

