[ext_resource type="Texture2D" path="res://assets/graphics/ep01_cabin/oblo.png" id="oblo1_sheet"]
[ext_resource type="Texture2D" path="res://assets/graphics/ep01_cabin/interphone.png" id="interphone_interphone"]
[ext_resource type="Texture2D" path="res://assets/graphics/ep01_cabin/interphone_tube.png" id="interphoneTube_interphoneTube"]
[ext_resource type="Script" path="res://scripts/hotspots/room_exit.gd" id="exit_script"]
[ext_resource type="Texture2D" path="res://assets/graphics/ep01_cabin/door_sub.png" id="door_door"]
[ext_resource type="Texture2D" path="res://assets/graphics/ep01_cabin/bed.png" id="bed_bed"]
[ext_resource type="Texture2D" path="res://assets/graphics/ep01_cabin/inventory_bottle.png" id="bottle_inventory_icon"]
