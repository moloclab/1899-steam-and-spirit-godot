[ext_resource type="Texture2D" path="res://assets/graphics/ep01_cabin/inventory_magnet_feather.png" id="magnet_feather_inventory_icon"]
[ext_resource type="Script" path="res://scripts/data/combination_definition.gd" id="combination_recipe"]
