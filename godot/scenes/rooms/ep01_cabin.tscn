; Metadati letti dal catalogo senza istanziare la stanza. Gli ingressi indicano la X di Churchill.
[sub_resource type="Resource" id="room_definition"]
script = ExtResource("room_definition_definition")
room_id = "ep01_cabin"
episode_id = "ep01"
scene_path = "res://scenes/rooms/ep01_cabin.tscn"
width = 648.0
entries = Dictionary[String, float]({"default": 180.0, "from_corridor": 550.0})

; Penna in inventario: testi e icona condivisi da raccolta, UI e salvataggi.
[sub_resource type="Resource" id="feather_inventory"]
script = ExtResource("inventory_definition")
item_id = "ep01_cabin_feather"
name_key = "ep01.inventory.feather.name"
description_key = "ep01.inventory.feather.examine"
icon = ExtResource("feather_inventory_icon")
collectible = true

; Oblò: sei ritagli da 48 x 48 pixel dello stesso foglio, condivisi dai due nodi.
[sub_resource type="AtlasTexture" id="oblo1_frame_0"]
atlas = ExtResource("oblo1_sheet")
region = Rect2(0, 0, 48, 48)

[sub_resource type="AtlasTexture" id="oblo1_frame_1"]
atlas = ExtResource("oblo1_sheet")
region = Rect2(48, 0, 48, 48)

[sub_resource type="AtlasTexture" id="oblo1_frame_2"]
atlas = ExtResource("oblo1_sheet")
region = Rect2(96, 0, 48, 48)

[sub_resource type="AtlasTexture" id="oblo1_frame_3"]
atlas = ExtResource("oblo1_sheet")
region = Rect2(144, 0, 48, 48)

[sub_resource type="AtlasTexture" id="oblo1_frame_4"]
atlas = ExtResource("oblo1_sheet")
region = Rect2(192, 0, 48, 48)

[sub_resource type="AtlasTexture" id="oblo1_frame_5"]
atlas = ExtResource("oblo1_sheet")
region = Rect2(240, 0, 48, 48)

; Animazione ciclica: duration pesa ogni fotogramma, speed esprime i fotogrammi al secondo.
[sub_resource type="SpriteFrames" id="oblo1_frames"]
animations = [{"frames": [{"duration": 1.0, "texture": SubResource("oblo1_frame_0")}, {"duration": 1.0, "texture": SubResource("oblo1_frame_1")}, {"duration": 1.0, "texture": SubResource("oblo1_frame_2")}, {"duration": 1.0, "texture": SubResource("oblo1_frame_3")}, {"duration": 1.0, "texture": SubResource("oblo1_frame_4")}, {"duration": 1.0, "texture": SubResource("oblo1_frame_5")}], "loop": true, "name": &"default", "speed": 2.5}]

; Bottiglia in inventario: collectible consente la raccolta tramite il comportamento comune.
[sub_resource type="Resource" id="bottle_inventory"]
script = ExtResource("inventory_definition")
item_id = "ep01_cabin_bottle"
name_key = "ep01.inventory.bottle.name"
description_key = "ep01.inventory.bottle.examine"
icon = ExtResource("bottle_inventory_icon")
collectible = true

; Calamita: viene raccolta dalla mappa, senza richiedere un nodo autonomo nella stanza.
[sub_resource type="Resource" id="magnet_inventory"]
script = ExtResource("inventory_definition")
item_id = "ep01_cabin_magnet"
name_key = "ep01.inventory.magnet.name"
description_key = "ep01.inventory.magnet.examine"
icon = ExtResource("magnet_inventory_icon")
collectible = true

; Penna magnetica: risultato di una combinazione, non raccoglibile direttamente dalla scena.
[sub_resource type="Resource" id="magnet_feather_inventory"]
script = ExtResource("inventory_definition")
item_id = "ep01_cabin_magnet_feather"
name_key = "ep01.inventory.magnet_feather.name"
description_key = "ep01.inventory.magnet_feather.examine"
icon = ExtResource("magnet_feather_inventory_icon")
collectible = false

; Ricetta simmetrica: consuma penna e calamita, aggiunge la penna magnetica e restituisce la risposta.
[sub_resource type="Resource" id="magnet_feather_combination"]
script = ExtResource("combination_recipe")
ingredients = Array[String](["ep01_cabin_feather","ep01_cabin_magnet"])
consumed = Array[String](["ep01_cabin_feather","ep01_cabin_magnet"])
results = Array[String](["ep01_cabin_magnet_feather"])
response_key = "ep01.inventory.magnet_feather.combine"

; Chiave: assegnata dall’enigma del lavandino, non dalla raccolta di un hotspot autonomo.
[sub_resource type="Resource" id="key_inventory"]
script = ExtResource("inventory_definition")
item_id = "ep01_cabin_key"
name_key = "ep01.inventory.key.name"
description_key = "ep01.inventory.key.examine"
icon = ExtResource("key_inventory_icon")
collectible = false

; Radice della cabina: collega le azioni dello script ai dati incorporati della stanza.
[node name="CABIN" type="Node2D" unique_id=124935942]
script = ExtResource("room_script")
definition = SubResource("room_definition")
; Definizioni della stanza di origine: disponibili nel catalogo anche quando è caricata un’altra stanza.
inventory_definitions = Array[ExtResource("inventory_definition")]([SubResource("feather_inventory"), SubResource("bottle_inventory"), SubResource("magnet_inventory"), SubResource("magnet_feather_inventory"), SubResource("key_inventory")])
combination_definitions = Array[ExtResource("combination_recipe")]([SubResource("magnet_feather_combination")])
; Varianti della mappa: sync_from_state sceglie la texture usando la raccolta persistente della calamita.
map_complete_texture = ExtResource("mapMagnet_mapMagnet")
map_collected_texture = ExtResource("mapMagnet_collected_texture")

; Fondale alle coordinate originali, con origine nell’angolo superiore sinistro.
[node name="Background" type="Sprite2D" parent="." unique_id=1915065628]
texture = ExtResource("background")
centered = false

; Mappa: resta esaminabile dopo la raccolta; lo script della stanza sostituisce la texture.
[node name="mapMagnet" type="Node2D" parent="."]
script = ExtResource("hotspot_script")
hotspot_id = "map"
hit_size = Vector2(60, 72)
position = Vector2(68, 64)
examine_response = "ep01.cabin.map.examine"

; Figlio grafico: il genitore mantiene posizione, area cliccabile e comportamento.
[node name="Visual" type="Sprite2D" parent="mapMagnet"]
texture = ExtResource("mapMagnet_mapMagnet")
centered = false

; Comodino: esame e interazione statica usano direttamente le risposte configurate.
[node name="como" type="Node2D" parent="."]
